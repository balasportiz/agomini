{
  email {$ACME_EMAIL:off}
}

{$SITE_DOMAIN:localhost} {
  encode zstd gzip
  reverse_proxy app:3000
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

{$IMAGE_DOMAIN:images.localhost} {
  encode zstd gzip
  reverse_proxy imgproxy:8080
  header -Server
}
