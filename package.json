{
  "name": "agomoni-run",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @agomoni/frontend --filter @agomoni/backend dev",
    "dev:frontend": "pnpm --filter @agomoni/frontend dev",
    "dev:backend": "pnpm --filter @agomoni/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0"
}
