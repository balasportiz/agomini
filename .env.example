# Host-development defaults. Docker Compose overrides service-network addresses.
DATABASE_URL=postgresql://agomoni:change-me@localhost:5432/agomoni_run
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When deploying the frontend to Vercel, set this to the VPS origin so the
# frontend fetches data from the right place.
# Leave empty on the VPS — the app talks to itself (same-origin).
NEXT_PUBLIC_API_URL=

APP_INTERNAL_URL=http://localhost:3000
STORAGE_ROOT=./storage/photos
UPLOAD_MAX_BYTES=15728640
STORAGE_RESERVE_BYTES=10737418240
IMGPROXY_BASE_URL=http://imgproxy:8080
IMGPROXY_PUBLIC_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=
POSTGRES_DB=agomoni_run
POSTGRES_USER=agomoni
POSTGRES_PASSWORD=change-me

# Google Drive photo import (both optional; leave empty to disable). See the
# "Media" collection's "Import from Google Drive" panel in the admin panel.
# - GOOGLE_DRIVE_API_KEY: a Google Cloud API key with the Drive API enabled.
#   Only works for files/folders shared "Anyone with the link" (no OAuth).
#   Create one at https://console.cloud.google.com/apis/credentials
# - GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON: the full contents of a Google Cloud
#   service account JSON key, as a single-line string. Works for private
#   Drive files/folders, as long as they are shared with the service
#   account's own email address (its "client_email" field) as a Viewer.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage — replaces local disk for photo uploads.
# Set all four vars to enable R2; leave S3_BUCKET empty to keep using disk.
#
# S3_ENDPOINT:  https://<account-id>.r2.cloudflarestorage.com
#               (your account ID is the 32-char hex in the endpoint URL)
# S3_BUCKET:    agomonirun
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: from the Account API Token page
# S3_PUBLIC_URL: the pub-xxxx.r2.dev URL shown after enabling
#               "Public Development URL" in bucket Settings.
#               Use a custom domain here once you configure one in Cloudflare.
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://4229c83669f0f7a0311f13c4974cdeae.r2.cloudflarestorage.com
S3_BUCKET=agomonirun
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
