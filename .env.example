# =============================================================================
# AGOMONI RUN 2.0 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.
#
# DEPLOYMENT TARGETS:
#   Local dev  → Docker Compose (postgres container, local disk storage)
#   Backend    → Render (single Docker container, Supabase PostgreSQL, R2 photos)
#   Frontend   → Vercel (Next.js, fetches data from Render backend via REST)
#   Future     → Oracle VPS (full Docker Compose stack, everything self-hosted)
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local Docker Compose:
#   DATABASE_URL=postgresql://agomoni:change-me@localhost:5432/agomoni_run
#
# Supabase (Render deployment — current setup):
#   Use Connect → Session pooler (port 6543). Direct Connection (db.*.supabase.co:5432)
#   is IPv6-only and Render cannot reach it (ENETUNREACH).
#   DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Oracle VPS (future):
#   DATABASE_URL=postgresql://agomoni:[PASSWORD]@postgres:5432/agomoni_run
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://agomoni:change-me@localhost:5432/agomoni_run

# Postgres container credentials — used by Docker Compose to create the local
# database. Not used when connecting to Supabase or any external database.
POSTGRES_DB=agomoni_run
POSTGRES_USER=agomoni
POSTGRES_PASSWORD=change-me


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Must be at least 32 random characters. Signs all Payload JWT tokens.
# Change this and all existing user sessions are invalidated.
# Generate: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# The public origin of the website (no trailing slash). Used for CORS/CSRF
# and Studio cookies. On Render this MUST be the Vercel custom domain, not
# the *.onrender.com URL, or login from agomonirun.com is rejected.
# Local:   http://localhost:3000
# Render:  https://agomonirun.com
# Vercel:  https://agomonirun.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal URL used by imgproxy to reach the /api/photos/[id]/source route.
# Local Docker Compose: http://app:3000
# Render / single container: http://localhost:3000
APP_INTERNAL_URL=http://localhost:3000

# When the FRONTEND (Vercel) needs to fetch data from the BACKEND (Render),
# set this to the Render backend URL.
# Leave empty on the backend itself — it talks to itself (same origin).
# Vercel: https://agomoni-backend.onrender.com
NEXT_PUBLIC_API_URL=


# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
# Local disk storage root. Only used when R2 is NOT configured (S3_BUCKET empty).
# On Render this path is ephemeral — always configure R2 for persistent storage.
STORAGE_ROOT=./storage/photos

# Maximum upload size in bytes (default 15 MB).
UPLOAD_MAX_BYTES=15728640

# Minimum free disk space to keep as a reserve (default 10 GB).
# Ignored when R2 is active.
STORAGE_RESERVE_BYTES=10737418240


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 — persistent photo storage (replaces local disk)
# -----------------------------------------------------------------------------
# Set all five vars to enable R2. Leave S3_BUCKET empty to use local disk.
#
# 1. S3_ENDPOINT — Cloudflare S3 API host (no bucket name in the URL):
#      https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#    The dashboard may show only r2.cloudflarestorage.com — if so, also set
#    S3_ACCOUNT_ID to your 32-character Cloudflare account ID.
#
# 2. S3_BUCKET — bucket name created in Cloudflare R2 dashboard.
#
# 3. S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#    From: Cloudflare R2 → Manage R2 API Tokens → Create Account API Token
#    Permissions: Object Read & Write, specify bucket: agomonirun
#
# 4. S3_PUBLIC_URL — enable in R2 bucket Settings → Public Development URL
#    Shape: https://pub-xxxx.r2.dev  (or your custom domain)
#    No trailing slash.
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCOUNT_ID=
S3_BUCKET=agomonirun
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=


# -----------------------------------------------------------------------------
# IMGPROXY — image resizing proxy (optional, not needed with R2)
# -----------------------------------------------------------------------------
# Only needed when running the full Docker Compose stack on Oracle VPS.
# On Render + R2: leave all four as shown — imgproxy is not used.
#
# IMGPROXY_KEY / IMGPROXY_SALT: generate with `openssl rand -hex 32`
# Required in production ONLY when NOT using R2 storage.
IMGPROXY_BASE_URL=http://imgproxy:8080
IMGPROXY_PUBLIC_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=


# -----------------------------------------------------------------------------
# CADDY — reverse proxy / TLS (Oracle VPS full stack only)
# -----------------------------------------------------------------------------
# Only used when starting the Docker Compose stack with --profile production.
# Not needed on Render — Render handles TLS automatically.
SITE_DOMAIN=agomonirun.in
IMAGE_DOMAIN=images.agomonirun.in
ACME_EMAIL=your@email.com


# -----------------------------------------------------------------------------
# GOOGLE DRIVE IMPORT (optional)
# -----------------------------------------------------------------------------
# Enables "Import from Google Drive" in the Studio gallery manager.
# Leave both empty to disable Drive import entirely.
#
# GOOGLE_DRIVE_API_KEY:
#   A Google Cloud API key with Drive API enabled.
#   Works only for files/folders shared "Anyone with the link".
#   Create at: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON:
#   Full contents of a Google Cloud service account JSON key FILE,
#   pasted as a single line (no newlines). Works for private Drive files
#   shared with the service account's client_email address.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
